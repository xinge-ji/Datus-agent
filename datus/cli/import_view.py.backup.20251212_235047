"""
import_view CLI接口模块

重构后的CLI接口，提供向后兼容的命令行入口。
"""

import sys
from typing import Any, Dict

from datus.configuration.agent_config import AgentConfig
from datus.tools.db_tools.db_manager import DBManager
from datus.utils.loggings import get_logger
from datus.cli.import_view_runner import ImportViewRunner

logger = get_logger(__name__)


def run_import_view(agent_config: AgentConfig, db_manager: DBManager, args) -> Dict[str, Any]:
    """
    运行视图导入功能的主入口（向后兼容）

    Args:
        agent_config: 代理配置
        db_manager: 数据库管理器
        args: 命令行参数

    Returns:
        执行结果统计
    """
    sourcedb_configs = agent_config.source_db_configs()
    if not sourcedb_configs:
        raise ValueError("未配置任何 sourcedb，请检查 agent.yml")

    # 解析参数
    namespace = getattr(args, 'namespace', 'default')
    update_strategy = getattr(args, 'update_strategy', 'incremental')
    step = getattr(args, 'step', 'all')

    # 新增的参数支持（向后兼容）
    interactive = getattr(args, 'interactive', False)
    dry_run = getattr(args, 'dry_run', False)

    # 为了向后兼容，如果使用了新参数名
    if hasattr(args, 'strategy'):
        update_strategy = args.strategy
    if hasattr(args, 'stage'):
        step = args.stage

    results: Dict[str, Dict[str, Any]] = {}
    names = list(sourcedb_configs.keys())

    logger.info(f"开始执行 import-view，sourcedb={names}，strategy={update_strategy}，step={step}")

    for name in names:
        try:
            runner = ImportViewRunner(
                agent_config=agent_config,
                db_manager=db_manager,
                namespace=namespace,
                sourcedb=name,
                strategy=update_strategy,
                step=step,
                interactive=interactive,
                dry_run=dry_run,
            )

            result = runner.run()
            results[name] = result

            # 输出结果摘要
            if dry_run:
                logger.info(f"[预览] {name}: 将处理 {result.get('preview', {}).get('tables_to_import', 0)} 个表, "
                          f"{result.get('preview', {}).get('views_to_import', 0)} 个视图")
            else:
                details = result.get('details', {})
                total_added = sum(d.get('added', 0) for d in details.values())
                total_updated = sum(d.get('updated', 0) for d in details.values())
                total_skipped = sum(d.get('skipped', 0) for d in details.values())
                logger.info(f"[完成] {name}: 新增 {total_added}, 更新 {total_updated}, 跳过 {total_skipped}")

        except Exception as e:
            logger.error(f"执行 sourcedb={name} 时发生错误: {e}")
            results[name] = {"error": str(e), "status": "failed"}

    return {"status": "success", "results": results}


if __name__ == "__main__":
    print("请通过 datus-agent import-view 调用本模块")
    sys.exit(1)